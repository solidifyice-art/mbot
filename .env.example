# ---------------------------------------------------------------------------
# Minecraft idle bot configuration template.
# Copy this file to `.env` and replace the placeholder values.
# NEVER commit a real `.env` file.
# ---------------------------------------------------------------------------

# --- Minecraft connection (required) ---------------------------------------
# Server hostname or IP address (no protocol, no port).
MC_HOST=your.server.example
# Server port.
MC_PORT=25565
# Bot username. On offline-mode servers this is the name other players see.
MC_USERNAME=IdleBot
# Optional client version, e.g. 1.21.11 or 26.1. Leave blank to auto-detect.
# For a 26.2 server, install ViaBackward and pin this to a supported version (26.1).
MC_VERSION=
# Authentication mode: offline | microsoft | mojang. Defaults to offline.
MC_AUTH=offline

# --- Idle jump routine (optional) ------------------------------------------
# Wait this long after spawning (and after each routine) before jumping.
# Default: 300000 (5 minutes).
JUMP_INTERVAL_MS=300000
# Number of jumps per routine. Default: 3.
JUMP_COUNT=3
# Approximate spacing between jump presses in milliseconds. Default: 1000.
JUMP_GAP_MS=1000
# How long the jump control is held down per jump in milliseconds. Default: 200.
JUMP_DURATION_MS=200

# --- Inventory checking (optional) -----------------------------------------
# How often to log a summary of the bot's inventory in milliseconds.
# Set to 0 to disable. Default: 60000 (1 minute).
INVENTORY_CHECK_INTERVAL_MS=60000

# --- Reconnection (optional) -----------------------------------------------
# Enable automatic reconnection after an unexpected disconnect. Default: true.
RECONNECT_ENABLED=true
# Initial delay before the first reconnect attempt in milliseconds. Default: 5000.
RECONNECT_INITIAL_MS=5000
# Maximum delay between reconnect attempts in milliseconds. Default: 300000.
RECONNECT_MAX_MS=300000
# Backoff multiplier applied after each failed attempt. Default: 2.
RECONNECT_FACTOR=2

# --- Optional HTTP health endpoint -----------------------------------------
# Only enable when deploying as a Render Web Service. Default: false.
ENABLE_HTTP=false
# Port for the health endpoint (Render provides this automatically). Default: 3000.
PORT=3000

# --- Logging ----------------------------------------------------------------
# One of: debug | info | warn | error. Default: info.
LOG_LEVEL=info
